{
  "id": "7ddb9a79",
  "name": "Typst Math",
  "version": "0.1.1",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "21.4.1"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": [],
      "enableMessageBridge": "localOnly"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "typstMath",
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 560
      },
      "label": {
        "default": "Typst Math"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    },
    {
      "type": "command",
      "id": "typstSettings",
      "label": {
        "default": "Typst Math Settings…"
      }
    },
    {
      "type": "command",
      "id": "typstRerenderAll",
      "label": {
        "default": "Re-render all Typst equations"
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
